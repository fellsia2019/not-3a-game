  entries:
  - kind: 0
    displayName: "\u0427\u0435\u0440\u0442\u0451\u0436 \u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438"
    shortLabel: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u0430\u044F"
    result: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438. \u041F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C\u0438."
    goldPrice: 100
  - kind: 1
    displayName: "\u0412\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u043e\u0445\u043e\u043c"
    shortLabel: "\u041f\u043e\u0441\u043e\u0445"
    result: "\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u044d\u043a\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0441\u043e\u0445 \u0438 \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u0435\u0433\u043e \u043d\u0430\u0432\u044b\u043a\u0438. \u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u0432\u043a\u0443 \u043f\u043e\u0441\u043e\u0445\u0430 \u0432 \u041d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043a\u0443\u0437\u043d\u0438\u0446\u0435 (\u0441\u0442\u0443\u043f\u0435\u043d\u044c II). \u0421\u0430\u043c \u043f\u043e\u0441\u043e\u0445 \u043c\u043e\u0436\u043d\u043e \u043a\u0443\u043f\u0438\u0442\u044c \u0443 \u0442\u043e\u0440\u0433\u043e\u0432\u0446\u0430."
    goldPrice: 100
  - kind: 2
    displayName: "\u041d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u043a\u0443\u0437\u043d\u0438\u0446\u0430 \u2192 II"
    shortLabel: "\u041a\u0443\u0437\u043d\u0438\u0446\u0430 II"
    result: "\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043a\u0443\u0437\u043d\u0438\u0446\u044b \u0434\u043e \u041d\u0435\u0431\u0435\u0441\u043d\u043e\u0439 \u043a\u0443\u0437\u043d\u0438\u0446\u044b (\u0441\u0442\u0443\u043f\u0435\u043d\u044c II). \u0421\u0430\u043c\u043e \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0432 \u043a\u0443\u0437\u043d\u0438\u0446\u0435."
    goldPrice: 200
  - kind: 3
    displayName: "\u041A\u0443\u0437\u043D\u0438\u0446\u0430 \u2192 III"
    shortLabel: "\u041A\u0443\u0437\u043D\u0438\u0446\u0430 III"
    result: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043A\u0443\u0437\u043D\u0438\u0446\u044B \u0434\u043E \u0441\u0442\u0443\u043F\u0435\u043D\u0438 III. \u0421\u0430\u043C\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043A\u0443\u0437\u043D\u0438\u0446\u0435."
